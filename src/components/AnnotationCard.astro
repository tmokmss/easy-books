---
// 注釈カードの器。中身は reader.ts がデータアイランドから組み立てる。
// PCではアンカー近くのポップオーバー、モバイルではボトムシート。
---

<div class="card-backdrop" id="card-backdrop" hidden></div>
<section
  class="ann-card"
  id="ann-card"
  role="dialog"
  aria-modal="false"
  aria-labelledby="ann-card-title"
  hidden
>
  <div class="ann-card-head">
    <h2 class="ann-card-title" id="ann-card-title"></h2>
    <button type="button" class="ann-card-close" id="ann-card-close" aria-label="閉じる">×</button>
  </div>
  <div class="ann-card-body" id="ann-card-body"></div>
</section>

<style is:global>
  /* reader.ts が中身を生成するためグローバルに置く */
  .card-backdrop {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: transparent;
  }

  .ann-card {
    position: absolute;
    z-index: 50;
    width: min(22rem, calc(100vw - 2rem));
    background: var(--card);
    color: var(--ink);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    box-shadow: 0 8px 28px rgb(0 0 0 / 0.18);
    padding: 0.9rem 1rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.75;
  }

  .ann-card[data-kind='person'] {
    border-top: 3px solid var(--person);
  }
  .ann-card[data-kind='note'] {
    border-top: 3px solid var(--note);
  }

  .ann-card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .ann-card-title {
    font-size: 0.95rem;
    margin: 0 0 0.3rem;
    line-height: 1.5;
  }

  .ann-card-close {
    appearance: none;
    background: none;
    border: none;
    color: var(--ink-muted);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
    border-radius: 6px;
    flex: none;
  }
  .ann-card-close:hover {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .ann-card-body p {
    margin: 0.4rem 0 0;
  }

  .ann-card .card-original {
    color: var(--ink-muted);
    font-size: 0.8rem;
  }

  .ann-card .card-label {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--ink-muted);
    margin-right: 0.4em;
  }

  .ann-card .card-aliases {
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .ann-card .card-aliases li {
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.05rem 0.55rem;
    font-size: 0.75rem;
  }

  .ann-card .card-unverified {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--note);
    border: 1px solid var(--note);
    border-radius: 4px;
    padding: 0 0.35em;
    margin-left: 0.5em;
    vertical-align: 0.1em;
  }

  .ann-card .card-sources {
    margin: 0.5rem 0 0;
    font-size: 0.72rem;
    color: var(--ink-muted);
  }

  /* モバイル: ボトムシート */
  @media (max-width: 719px) {
    .ann-card {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      max-height: 70dvh;
      overflow-y: auto;
      border-radius: 14px 14px 0 0;
      padding-bottom: calc(1rem + env(safe-area-inset-bottom));
      box-shadow: 0 -8px 28px rgb(0 0 0 / 0.22);
    }
    .card-backdrop {
      background: rgb(0 0 0 / 0.25);
    }
  }
</style>
