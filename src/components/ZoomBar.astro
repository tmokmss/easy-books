---
// 現在位置バー: いま作品全体のどこを読んでいるかを常に出す。
// 部と章の区切りが見え、既読が塗られ、タップでその章へ飛べる＝実質的な目次。
// 塗りとマーカーは progress.ts が描く。

interface BarChapter {
  id: string;
  /** 章の表示名（部名を含む。例: 第一部 第一章） */
  label: string;
  count: number;
  href: string;
  isCurrent: boolean;
  isPartStart: boolean;
}

interface Props {
  chapters: BarChapter[];
}

const { chapters } = Astro.props;
---

<nav class="zoom-bar" aria-label="作品全体の現在位置">
  {
    chapters.map((c) => (
      <a
        class:list={['zb-seg', { cur: c.isCurrent, 'part-start': c.isPartStart }]}
        data-ch={c.id}
        href={c.href}
        style={`flex-grow: ${c.count}`}
        title={c.label}
        aria-current={c.isCurrent ? 'page' : undefined}
      >
        <span class="zb-fill" />
      </a>
    ))
  }
  <span class="zb-marker" hidden aria-hidden="true"></span>
</nav>

<style>
  .zoom-bar {
    position: sticky;
    top: var(--toolbar-h);
    z-index: 29;
    display: flex;
    gap: 1px;
    height: 14px;
    padding: 3px 1rem;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--hairline);
  }

  .zb-seg {
    position: relative;
    flex-basis: 0;
    min-width: 2px;
    background: color-mix(in srgb, var(--ink) 10%, transparent);
    border-radius: 2px;
    overflow: hidden;
  }
  .zb-seg.part-start {
    margin-left: 4px;
  }
  .zb-seg:first-child {
    margin-left: 0;
  }
  .zb-seg:hover {
    background: color-mix(in srgb, var(--ink) 22%, transparent);
  }
  .zb-seg.cur {
    outline: 1px solid var(--person);
    outline-offset: 0;
  }

  .zb-fill {
    display: block;
    height: 100%;
    width: 0;
    background: color-mix(in srgb, var(--person) 55%, transparent);
  }

  .zb-marker {
    position: absolute;
    top: 1px;
    left: 0;
    width: 2px;
    height: calc(100% - 2px);
    background: var(--note);
    pointer-events: none;
  }
  .zb-marker[hidden] {
    display: none;
  }
</style>
