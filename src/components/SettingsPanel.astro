---
// 表示設定パネル。settings.ts が入力と localStorage を同期する。
---

<div class="settings-backdrop" id="settings-backdrop" hidden></div>
<section
  class="settings-panel"
  id="settings-panel"
  role="dialog"
  aria-modal="false"
  aria-label="表示設定"
  hidden
>
  <fieldset class="settings-group">
    <legend>文字サイズ</legend>
    <div class="seg" role="group">
      <label><input type="radio" name="fs" value="1" /><span>小</span></label>
      <label><input type="radio" name="fs" value="2" /><span>標準</span></label>
      <label><input type="radio" name="fs" value="3" /><span>大</span></label>
      <label><input type="radio" name="fs" value="4" /><span>特大</span></label>
    </div>
  </fieldset>

  <fieldset class="settings-group">
    <legend>行間</legend>
    <div class="seg" role="group">
      <label><input type="radio" name="lh" value="1" /><span>狭い</span></label>
      <label><input type="radio" name="lh" value="2" /><span>標準</span></label>
      <label><input type="radio" name="lh" value="3" /><span>広い</span></label>
    </div>
  </fieldset>

  <fieldset class="settings-group">
    <legend>読解支援</legend>
    <label class="toggle">
      <input type="checkbox" name="gloss" />
      <span>愛称に本名を添える</span>
    </label>
    <label class="toggle">
      <input type="checkbox" name="rmark" />
      <span>代名詞にも印をつける</span>
    </label>
    <label class="toggle">
      <input type="checkbox" name="bilingual" />
      <span>対訳（原文）を表示</span>
    </label>
  </fieldset>

  <fieldset class="settings-group">
    <legend>表示</legend>
    <label class="toggle">
      <input type="checkbox" name="vertical" />
      <span>縦書き</span>
    </label>
    <label class="toggle">
      <input type="checkbox" name="theme" />
      <span>夜モード</span>
    </label>
  </fieldset>
</section>

<style>
  .settings-backdrop {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: transparent;
  }

  .settings-panel {
    position: fixed;
    top: calc(var(--toolbar-h) + 0.5rem);
    right: 0.75rem;
    z-index: 70;
    width: min(19rem, calc(100vw - 1.5rem));
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    box-shadow: 0 10px 32px rgb(0 0 0 / 0.2);
    padding: 0.5rem 1rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }

  .settings-group {
    border: none;
    margin: 0.7rem 0 0;
    padding: 0;
  }

  .settings-group legend {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    padding: 0;
    margin-bottom: 0.35rem;
  }

  .seg {
    display: flex;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    overflow: hidden;
  }

  .seg label {
    flex: 1;
    position: relative;
  }

  .seg input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .seg span {
    display: block;
    text-align: center;
    padding: 0.35rem 0.2rem;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  .seg label + label span {
    border-left: 1px solid var(--hairline);
  }

  .seg input:checked + span {
    background: var(--person);
    color: var(--paper);
  }

  .seg input:focus-visible + span {
    outline: 2px solid var(--person);
    outline-offset: -2px;
  }

  .toggle {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.3rem 0;
    cursor: pointer;
  }

  .toggle input {
    accent-color: var(--person);
    width: 1rem;
    height: 1rem;
    margin: 0;
  }
</style>
